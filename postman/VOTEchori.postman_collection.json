            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MALPRACTICE\",\n  \"location\": \"Booth 12, Mumbai\",\n  \"description\": \"Suspicious activity observed near booth gate\",\n  \"severity\": \"HIGH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            }
          }
        },
